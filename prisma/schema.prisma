enum ConsultationStatus {
  Requested
  InProgress
  Completed
}

model SyncLog {
  id            String     @id @default(uuid())
  deviceId      String
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  syncTimestamp DateTime   @default(now())
  recordsPushed Int
  recordsPulled Int
  status        SyncStatus
}

enum SyncStatus {
  Success
  Failed
  Partial
}

model Referral {
  id             String         @id @default(uuid())
  patientId      String
  createdById    String
  referredTo     String // hospital or facility name
  reason         String // clinical reason for referral
  notesEncrypted String? // encrypted notes (sensitive)
  attachmentUrl  String? // optional S3 document
  status         ReferralStatus @default(INITIATED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  patient   Patient @relation(fields: [patientId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])
}

enum ReferralStatus {
  INITIATED
  SENT
  RECEIVED
  COMPLETED
  CLOSED
}

model Pregnancy {
  id           String    @id @default(uuid())
  patientId    String
  startDate    DateTime
  estimatedDue DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  visits     Visit[]
  patient    Patient    @relation(fields: [patientId], references: [id])
  deliveries Delivery[]
}

model PasswordResetOTP {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  code      String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, code])
  @@index([expiresAt])
}

model ANCRecord {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // Basic Information (cont'd)
  lmp           DateTime? // Last Menstrual Period
  edd           DateTime? // Estimated Due Date
  gravida       Int? // Number of pregnancies
  para          Int? // Number of births
  abortion      Int? // Number of abortions
  ectopicPreg   Int? // Number of ectopic pregnancies
  childrenAlive Int? // Number of children alive

  // General Medical History
  diabetesMellitus          Boolean?
  cardiacDisease            Boolean?
  chronicHypertension       Boolean?
  otherMedicalCondition     Boolean?
  otherMedicalConditionText String?

  // Lab Tests
  vdrl         String? // VDRL test result
  hiv          String? // HIV test result
  hbsAg        String? // HBs Ag test result
  rbs          String? // RBS (Random Blood Sugar)
  fbs          String? // FBS (Fasting Blood Sugar)
  bloodGroupRh String? // Blood Group & Rh
  ua           String? // UA (Urinalysis)

  // Supplement
  td String? // TD1, TD2, TD3, TD4, TD5

  // Initial Evaluation: General Exam
  generalExamGeneral String?
  generalExamPallor  String?
  jaundice           Boolean?
  chestAbnormality   Boolean?
  heartAbnormality   Boolean?

  // Initial Evaluation: Gyn Exam
  vulvarUlcer      Boolean?
  vaginalDischarge Boolean?
  pelvicMass       Boolean?
  cervicalLesion   Boolean?
  uterineSizeWks   Int? // Uterine size in weeks

  // Counseling/Testing
  dangerSignsAdvised       Boolean?
  birthPreparednessAdvised Boolean?
  motherHivTestAccepted    Boolean?
  hivTestResult            String? // R, NR, I

  // HIV + Care & Follow-up
  hivTestResultReceived  Boolean?
  counseledInfantFeeding Boolean?
  referredForCare        Boolean?
  partnerHivTestResult   String? // R, NR, I

  // Present Pregnancy: Follow up
  gaLmp                   String? // Gestational Age (LMP)
  complaints              String?
  bloodPressure           String?
  weightKg                Float?
  pallor                  String?
  hemoglobin              String? // Hgb
  uterineHeightWks        Int? // Uterine Height in Weeks
  presentation            String?
  descent                 String?
  fetalHeartRate          String? // FHR
  remarks                 String?
  nextFollowUpDate        DateTime?
  dangerSignsIdentified   String?
  actionAdviceCounselling String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Delivery {
  id           String  @id @default(uuid())
  patientId    String
  pregnancyId  String?
  recordedById String

  // Delivery Details
  deliveryDate DateTime?
  deliveryTime String?

  // AMTSL (Active Management of Third Stage of Labor)
  amtsl String? // Ergomtrine, Oxytocine, Misoprostol

  // Placenta
  placenta String? // Completed, Incomplete, CCT, MRP

  // Laceration
  laceration String? // 1st Degree, 2nd Degree, 3rd Degree

  // Management
  obstetricCxManaged     Boolean? @default(false)
  aphManaged             Boolean? @default(false)
  rupturedUx             Boolean? @default(false)
  eclampsiaManaged       Boolean? @default(false)
  pphManaged             Boolean? @default(false)
  promSepsisManaged      Boolean? @default(false)
  obstPrologLaborManaged Boolean? @default(false)

  // HIV Details
  hivCounsTestingOffered String?
  hivTestingAccepted     String?
  hivTestResult          String?
  arvpxForMothers        String? // ARVPX for mothers (by type)
  arvpxForNb             String? // ARVPX for NB (by type)
  feedingOptionEbf       String?
  rf                     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient    Patient    @relation(fields: [patientId], references: [id])
  pregnancy  Pregnancy? @relation(fields: [pregnancyId], references: [id])
  recordedBy User       @relation(fields: [recordedById], references: [id])
  newborns   Newborn[]
  pncVisits  PNCVisit[]
}

model Newborn {
  id         String @id @default(uuid())
  deliveryId String

  // Newborn Details
  quantity   String? // Single, Multiple
  sex        String? // Male, Female
  termStatus String? // Term, Preterm
  alive      Boolean? @default(true)
  apgarScore Int?
  sb         String? // Mac, Fresh (Stillbirth)

  // Measurements
  birthWeightGm Float? // Birth weight in grams
  lengthCm      Float? // Length in cm

  // Care
  vitK              Boolean? @default(false)
  ttc               Boolean? @default(false)
  babyMotherBonding Boolean? @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  delivery Delivery @relation(fields: [deliveryId], references: [id])
}

model PNCVisit {
  id           String  @id @default(uuid())
  patientId    String
  deliveryId   String? // Link to delivery record
  recordedById String

  visitDate DateTime @default(now())

  // Postpartum Visit Part 1
  bloodPressure         String? // BP
  tpr                   String? // Temperature, Pulse, Respiration
  temperature           Float?
  uterusContracted      String? // Uterus Contracted/Look for PPH
  dribblingLeakingUrine String? // Dribbling, Leaking Urine

  // Postpartum Visit Part 2
  anemia                String?
  vaginalDischarge      String? // Vaginal discharge (after 4wks Delivery)
  breast                String?
  vitaminA              String?
  counselingDangerSigns String? // Counseling danger signs EPI, Use of ITN given

  // Postpartum Visit Part 3 - Baby
  babyBreathing     String?
  babyBreastFeeding String?
  babyWeightGm      Float? // Baby Wt.(gm.)
  immunization      String?

  // Postpartum Visit Part 4 - HIV
  hivTested       String?
  hivTestResult   String? // R/NR
  arvPxForMother  String? // ARV Px for Mother
  arvPxForNewborn String? // ARV Px for Newborn
  feedingOption   String? // EBF/RF

  // Postpartum Visit Part 5
  motherReferredToCare   String? // Mother Referred to Care & Support
  newbornReferredToCare  String? // Newborn referred to Chronic HIV infant Care
  fpCounseledAndProvided String? // FP counseled & Provided
  remark                 String?
  actionTaken            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient    Patient   @relation(fields: [patientId], references: [id])
  delivery   Delivery? @relation(fields: [deliveryId], references: [id])
  recordedBy User      @relation(fields: [recordedById], references: [id])
}
