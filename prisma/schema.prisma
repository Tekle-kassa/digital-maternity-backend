model UserRole {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  role      Role     @relation(fields: [roleId], references: [id])
  roleId    String
  grantedBy String?
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model AuditLog {
  id        String   @id @default(uuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  action    String
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())
}

enum Language {
  EN
  SO
}

model Patient {
  id               String   @id @default(uuid())
  fullName         String
  unfpId           String   @unique
  cardNo           String? // Card number from UI
  phone            String?
  email            String?
  // dob              DateTime?
  age              Int?
  address          String?
  subCity          String? // Sub-city from UI
  woreda           String? // Woreda from UI
  kebele           String? // Kebele from UI
  houseNo          String? // House number from UI
  facility         String? // Name of Facility from UI
  maritalStatus    String? // Marital Status from UI
  idNumber         String? // ID (Number or Photo) from UI
  emergencyContact String?
  // photoUrl        String?
  createdAt        DateTime @default(now())
  createdById      String
  createdBy        User     @relation("UserCreatedPatients", fields: [createdById], references: [id])
  // demographics    PatientDemographics?

  visits           Visit[]
  // ultrasoundScans Ultrasound[]
  // gbvCases        GBVCase[]
  // consultations   Consultation[]
  gbvreports       GBVReport[]
  ultrasounds      Ultrasound[]
  referrals        Referral[]
  pregnancies      Pregnancy[]
  ancRecords       ANCRecord[]
  deliveries       Delivery[]
  pncVisits        PNCVisit[]
  gbvScreenings    GBVScreening[]
  srhRegistrations SRHRegistration[]
}

