// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "erd.svg" // or erd.png, erd.jpeg, erd.pdf
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- DMP API (API-REFERENCE.md / database-schema.sql) ---

enum ApiClinicType {
  fixed
  mobile
}

enum ApiClinicStatus {
  active
  inactive
}

enum ApiAppointmentType {
  prenatal_checkup
  ultrasound
  lab_test
  follow_up
  teleconsult
}

enum ApiAppointmentStatus {
  scheduled
  confirmed
  in_progress
  completed
  missed
  cancelled
}

enum ApiConsultPriority {
  routine
  urgent
  emergency
}

enum ApiAlertType {
  appointment
  risk
  teleconsult
  sync
  system
  gbv
}

enum ApiAlertPriority {
  low
  medium
  high
  critical
}

enum ApiConsultationType {
  general
  high_risk
  ultrasound_review
  gbv
  complication
}

enum ApiConsultStatus {
  pending
  assigned
  in_review
  responded
  closed
}

enum DmpEntitySyncStatus {
  synced
  pending
  conflict
}

enum SyncQueueAction {
  create
  update
  delete
}

enum SyncQueueStatus {
  pending
  uploading
  downloading
  completed
  failed
}

enum UploadFileCategory {
  ultrasound
  attachment
  avatar
  document
}

model Clinic {
  id           String          @id @default(uuid())
  name         String
  location     String
  region       String
  zone         String
  woreda       String
  type         ApiClinicType
  status       ApiClinicStatus @default(active)
  patientCount Int             @default(0)
  lastSync     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  users        User[]
  appointments Appointment[]
}

model User {
  id                 String             @id @default(uuid())
  passwordHash       String
  phone              String             @unique
  email              String?            @unique
  fullName           String?
  displayId          String?            // Display ID for profile (e.g. 10000100)
  profileImageUrl    String?            // Avatar / profile picture URL
  preferredLanguage  String?            // e.g. EN, SO (Language enum)
  clinicId           String?
  clinic             Clinic?            @relation(fields: [clinicId], references: [id])
  roles              UserRole[]
  isActive           Boolean            @default(true)
  mustChangePassword Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  patientsCreated    Patient[]          @relation("UserCreatedPatients")
  visitsRecorded     Visit[]            @relation("UserRecordedANC")
  ultrasoundScans    Ultrasound[]
  // gbvcases          GBVCase[]
  // consultations     Consultation[]
  syncLogs           SyncLog[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  gbvreports         GBVReport[]
  referralsCreated   Referral[]
  passwordResetOTPs  PasswordResetOTP[]
  deliveries         Delivery[]
  pncVisits          PNCVisit[]
  gbvScreenings      GBVScreening[]
  srhRegistrations   SRHRegistration[]
  conversationsAsUser1 Conversation[] @relation("User1Conversations")
  conversationsAsUser2 Conversation[] @relation("User2Conversations")
  messagesSent        Message[]       @relation("MessagesSent")
  messagesReceived    Message[]       @relation("MessagesReceived")
  alertsForUser       UserAlert[]     @relation("AlertTargetUser")
  alertsAcknowledged  UserAlert[]     @relation("AlertAcknowledgedBy")
  appointmentsAsMidwife Appointment[]   @relation("AppointmentMidwife")
  tcRequested         TeleconsultRequest[] @relation("TcRequestedBy")
  tcAssigned          TeleconsultRequest[] @relation("TcAssigned")
  teleconsultResponses TeleconsultResponse[]
  uploadedFiles       UploadedFile[]
  notificationPreference NotificationPreference?
  userSessions        UserSession[]
}

model Role {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  // permissions RolePermission[]
  userRoles   UserRole[]
}

