enum ConsultationStatus {
  Requested
  InProgress
  Completed
}

model SyncLog {
  id            String     @id @default(uuid())
  deviceId      String
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  syncTimestamp DateTime   @default(now())
  recordsPushed Int
  recordsPulled Int
  status        SyncStatus
}

enum SyncStatus {
  Success
  Failed
  Partial
}

model Referral {
  id             String         @id @default(uuid())
  patientId      String
  createdById    String
  referredTo     String // hospital or facility name
  reason         String // clinical reason for referral
  notesEncrypted String? // encrypted notes (sensitive)
  attachmentUrl  String? // optional S3 document
  status         ReferralStatus @default(INITIATED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  patient   Patient @relation(fields: [patientId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])
}

enum ReferralStatus {
  INITIATED
  SENT
  RECEIVED
  COMPLETED
  CLOSED
}

model Pregnancy {
  id           String    @id @default(uuid())
  patientId    String
  startDate    DateTime
  estimatedDue DateTime?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  visits     Visit[]
  patient    Patient    @relation(fields: [patientId], references: [id])
  deliveries Delivery[]
}

model PasswordResetOTP {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  code      String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, code])
  @@index([expiresAt])
}

model ANCRecord {
  id        String  @id @default(uuid())
  patientId String
  patient   Patient @relation(fields: [patientId], references: [id])

  // Consent (Register Client - Screen 1)
  clientConsentSignature             String? // Client consent signature
  healthProfessionalConsentSignature String? // Health professional consent signature

  // Basic Information (cont'd)
  lmp           DateTime? // Last Menstrual Period
  edd           DateTime? // Estimated Due Date
  gravida       Int? // Number of pregnancies
  para          Int? // Number of births
  abortion      Int? // Number of abortions
  ectopicPreg   Int? // Number of ectopic pregnancies
  childrenAlive Int? // Number of children alive

  // Past Obstetric History (array: year, GA, mode of delivery, sex, birth weight kg)
  pastObstetricHistory Json?

  // General Medical History
  diabetesMellitus             Boolean?
  diabetesMellitusMoreInfo     String?
  cardiacDisease               Boolean?
  cardiacDiseaseMoreInfo       String?
  chronicHypertension          Boolean?
  chronicHypertensionMoreInfo  String?
  otherMedicalCondition        Boolean?
  otherMedicalConditionText    String?

  // Lab Tests
  vdrl         String? // VDRL test result
  hiv          String? // HIV test result
  hbsAg        String? // HBs Ag test result
  rbs          String? // RBS (Random Blood Sugar)
  fbs          String? // FBS (Fasting Blood Sugar)
  bloodGroupRh String? // Blood Group & Rh
  ua           String? // UA (Urinalysis)

  // Supplement
  td String? // TD1, TD2, TD3, TD4, TD5

  // Initial Evaluation: General Exam
  generalExamGeneral       String?
  generalExamPallor        String?
  jaundice                 Boolean?
  chestAbnormality         Boolean?
  chestAbnormalityMoreInfo String?
  heartAbnormality         Boolean?
  heartAbnormalityMoreInfo String?

  // Initial Evaluation: Gyn Exam
  vulvarUlcer      Boolean?
  vaginalDischarge Boolean?
  pelvicMass       Boolean?
  cervicalLesion   Boolean?
  uterineSizeWks   Int? // Uterine size in weeks

  // Counseling/Testing
  dangerSignsAdvised       Boolean?
  birthPreparednessAdvised Boolean?
  motherHivTestAccepted    Boolean?
  hivTestResult            String? // R, NR, I

  // HIV + Care & Follow-up
  hivTestResultReceived  Boolean?
  counseledInfantFeeding Boolean?
  referredForCare        Boolean?
  partnerHivTestResult   String? // R, NR, I

  // Present Pregnancy: Follow up
  gaLmp                   String? // Gestational Age (LMP)
  complaints              String?
  bloodPressure           String?
  weightKg                Float?
  pallor                  String?
  hemoglobin              String? // Hgb
  uterineHeightWks        Int? // Uterine Height in Weeks
  presentation            String?
  descent                 String?
  fetalHeartRate          String? // FHR
  remarks                 String?
  nextFollowUpDate        DateTime?
  dangerSignsIdentified   String?
  actionAdviceCounselling String?

  registrationVisit Visit? @relation("VisitToANCRecord")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Delivery {
  id           String  @id @default(uuid())
  patientId    String
  pregnancyId  String?
  recordedById String

  // Consent (Delivery Summary Recording - Screen 1)
  clientConsentSignature             String?
  healthProfessionalConsentSignature String?

  // Delivery Details (Screen 2)
  deliveryDate DateTime?
  deliveryTime String?
  referral     Boolean? // Referral Yes/No
  referralInfo String? // Optional referral details

  // AMTSL (Active Management of Third Stage of Labor)
  amtsl String? // Ergometrine, Oxytocin, Misoprostol

  // Placenta (UI: Completed, Incomplete, CCT, MRP; NRP legacy)
  placenta String?

  // Laceration (1st Degree, 2nd Degree, 3rd Degree)
  laceration String?

  // Management (Screen 3)
  obstetricCxManaged     Boolean? @default(false)
  aphManaged             Boolean? @default(false)
  rupturedUx             Boolean? @default(false)
  eclampsiaManaged       Boolean? @default(false)
  pphManaged             Boolean? @default(false)
  promSepsisManaged      Boolean? @default(false)
  obstPrologLaborManaged Boolean? @default(false)

  // Delivery Assistance (Screen 4)
  deliveryAssistanceMeasures String?
  deliveryAssistanceMore     String?

  // HIV Details (Screen 7 in UI)
  hivCounsTestingOffered String?
  hivTestingAccepted     String?
  hivTestResult          String?
  arvpxForMothers        String? // ARV/PX for mothers (by type)
  arvpxForNb             String? // ARV/PX for NB (by type)
  feedingOptionEbf      String?
  rf                     String? // Replacement feeding / BF

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient    Patient    @relation(fields: [patientId], references: [id])
  pregnancy  Pregnancy? @relation(fields: [pregnancyId], references: [id])
  recordedBy User       @relation(fields: [recordedById], references: [id])
  newborns   Newborn[]
  pncVisits  PNCVisit[]
}

model Newborn {
  id         String @id @default(uuid())
  deliveryId String

  // Newborn Details
  quantity   String? // Single, Multiple
  sex        String? // Male, Female
  termStatus String? // Term, Preterm
  alive      Boolean? @default(true)
  apgarScore Int?
  sb         String? // Mac, Fresh (Stillbirth)

  // Measurements
  birthWeightGm Float? // Birth weight in grams
  lengthCm      Float? // Length in cm

  // Care
  vitK              Boolean? @default(false)
  ttc               Boolean? @default(false)
  babyMotherBonding Boolean? @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  delivery Delivery @relation(fields: [deliveryId], references: [id])
}

model PNCVisit {
  id           String  @id @default(uuid())
  patientId    String
  deliveryId   String? // Link to delivery record
  recordedById String

  // Consent (PNC Medical Recording - Screen 1)
  clientConsentSignature             String? // PNC Client consent signature
  healthProfessionalConsentSignature String? // Health Professional consent signature

  visitDate DateTime @default(now())

  // Postpartum Visit Part 1 (Screen 2 - Vitals & Uterine)
  bloodPressure         String? // BP
  tpr                   String? // Temperature, Pulse, Respiration
  temperature           Float?
  uterusContracted      String? // Uterus Contracted/Look for PPH
  dribblingLeakingUrine String? // Dribbling, Leaking Urine

  // Postpartum Visit Part 2
  anemia                String?
  vaginalDischarge      String? // Vaginal discharge (after 4wks Delivery)
  breast                String?
  vitaminA              String?
  counselingDangerSigns String? // Counseling danger signs EPI, Use of ITN given

  // Postpartum Visit Part 3 - Baby
  babyBreathing     String?
  babyBreastFeeding String?
  babyWeightGm      Float? // Baby Wt.(gm.)
  immunization      String?

  // Postpartum Visit Part 4 - HIV
  hivTested       String?
  hivTestResult   String? // R/NR
  arvPxForMother  String? // ARV Px for Mother
  arvPxForNewborn String? // ARV Px for Newborn
  feedingOption   String? // EBF/RF

  // Postpartum Visit Part 5
  motherReferredToCare   String? // Mother Referred to Care & Support
  newbornReferredToCare  String? // Newborn referred to Chronic HIV infant Care
  fpCounseledAndProvided String? // FP counseled & Provided
  remark                 String?
  actionTaken            String?

  registrationVisit Visit? @relation("VisitToPNCVisit")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient    Patient   @relation(fields: [patientId], references: [id])
  delivery   Delivery? @relation(fields: [deliveryId], references: [id])
  recordedBy User      @relation(fields: [recordedById], references: [id])
}

model Conversation {
  id        String   @id @default(uuid())
  user1Id   String   // canonical: user1Id < user2Id
  user2Id   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1    User     @relation("User1Conversations", fields: [user1Id], references: [id], onDelete: Cascade)
  user2    User     @relation("User2Conversations", fields: [user2Id], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([user1Id, user2Id])
  @@index([user1Id, user2Id])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  recipientId    String
  body           String
  attachmentUrl  String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient    User         @relation("MessagesReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([recipientId, readAt])
}

model Appointment {
  id                   String              @id @default(uuid())
  patientId            String
  patient              Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type                 ApiAppointmentType
  visitNumber          Int?
  gestationalAgeWeeks  Int?
  gestationalAgeDays   Int?
  scheduledDate        DateTime
  scheduledTime        String
  clinicId             String
  clinic               Clinic              @relation(fields: [clinicId], references: [id])
  midwifeId            String
  midwife              User                @relation("AppointmentMidwife", fields: [midwifeId], references: [id])
  priority             ApiConsultPriority  @default(routine)
  status               ApiAppointmentStatus @default(scheduled)
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([patientId])
  @@index([clinicId])
  @@index([scheduledDate])
}

model UserAlert {
  id                 String           @id @default(uuid())
  type               ApiAlertType
  priority           ApiAlertPriority
  title              String
  message            String
  patientId          String?
  patient            Patient?         @relation(fields: [patientId], references: [id], onDelete: SetNull)
  targetUserId       String
  targetUser         User             @relation("AlertTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  readAt             DateTime?
  acknowledgedAt     DateTime?
  acknowledgedById   String?
  acknowledgedBy     User?            @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id])
  actionRequired     Boolean          @default(false)
  actionUrl          String?
  createdAt          DateTime         @default(now())

  @@index([targetUserId])
  @@index([patientId])
}

model TeleconsultRequest {
  id                     String               @id @default(uuid())
  patientId              String
  patient                Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requestedById          String
  requestedBy            User                 @relation("TcRequestedBy", fields: [requestedById], references: [id])
  requestDate            DateTime             @default(now())
  priority               ApiConsultPriority
  consultationType       ApiConsultationType
  chiefComplaint         String
  clinicalNotes          String               @default("")
  assignedSpecialistId     String?
  assignedSpecialist     User?                @relation("TcAssigned", fields: [assignedSpecialistId], references: [id])
  status                 ApiConsultStatus     @default(pending)
  syncStatus             DmpEntitySyncStatus  @default(pending)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  response               TeleconsultResponse?
  attachments            TeleconsultAttachment[]

  @@index([patientId])
  @@index([status])
}

model TeleconsultAttachment {
  id             String               @id @default(uuid())
  teleconsultId  String
  teleconsult    TeleconsultRequest   @relation(fields: [teleconsultId], references: [id], onDelete: Cascade)
  type           String
  fileUrl        String
  fileName       String
  createdAt      DateTime             @default(now())
}

model TeleconsultResponse {
  id                     String               @id @default(uuid())
  teleconsultId          String               @unique
  teleconsult            TeleconsultRequest   @relation(fields: [teleconsultId], references: [id], onDelete: Cascade)
  respondedById          String
  respondedBy            User                 @relation(fields: [respondedById], references: [id])
  respondedAt            DateTime             @default(now())
  diagnosis              String?
  recommendations        String
  followUpInstructions   String
  prescriptions          String[]             @default([])
}

model RiskRule {
  id          String   @id @default(uuid())
  name        String
  description String
  condition   String
  weight      Int
  version     String   @default("1.0")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UploadedFile {
  id           String       @id @default(uuid())
  filename     String
  url          String
  thumbnailUrl String?
  size         BigInt
  mimeType     String
  category     UploadFileCategory
  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())

  @@index([uploadedById])
}

model NotificationPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAlerts       Boolean  @default(true)
  smsAlerts         Boolean  @default(false)
  criticalOnly      Boolean  @default(false)
  alertAppointment  Boolean  @default(true)
  alertRisk         Boolean  @default(true)
  alertTeleconsult  Boolean  @default(true)
  alertSync         Boolean  @default(true)
  alertSystem       Boolean  @default(true)
  alertGbv          Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model UserSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device      String?
  ipAddress   String?
  lastActive  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([userId])
}

model SyncQueueItem {
  id            String           @id @default(uuid())
  entityType    String
  entityId      String
  action        SyncQueueAction
  status        SyncQueueStatus  @default(pending)
  payload       Json?
  progress      Int?
  errorMessage  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status])
}

/** Idempotent store for mutations received from a local facility server (Option B: local hub → central). */
model IngestedSyncMutation {
  id                String   @id @default(uuid())
  facilityId        String
  sourceQueueItemId String
  entityType        String
  entityId          String
  action            String
  payload           Json?
  createdAt         DateTime @default(now())

  @@unique([facilityId, sourceQueueItemId])
  @@index([facilityId])
  @@index([entityType, entityId])
}

model SyncConflict {
  id               String   @id @default(uuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  field            String
  localValue       String
  serverValue      String
  localTimestamp   DateTime
  serverTimestamp  DateTime
  resolved         Boolean  @default(false)
  resolution       String?
  resolvedAt       DateTime?
  createdAt        DateTime @default(now())

  @@index([patientId])
  @@index([resolved])
}
