model Visit {
  id           String  @id @default(uuid())
  patientId    String
  pregnancyId  String?
  recordedById String

  visitDate      DateTime
  visitNumber    Int?
  visitType      String?
  gestationalAge Int? //remove
  bloodPressure  String?
  temperature    Float?
  // bpSystolic        Int
  // bpDiastolic       Int
  weight         Float?
  symptoms       String?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  // riskScore         RiskScore
  pregnancy      Pregnancy? @relation(fields: [pregnancyId], references: [id])

  /** Clinical program this encounter belongs to (for patient timelines). */
  visitCaseCategory VisitCaseCategory @default(GENERAL)

  ancRecordId    String? @unique
  ancRecord      ANCRecord?    @relation("VisitToANCRecord", fields: [ancRecordId], references: [id], onDelete: SetNull)
  pncVisitId     String? @unique
  pncVisit       PNCVisit?     @relation("VisitToPNCVisit", fields: [pncVisitId], references: [id], onDelete: SetNull)
  gbvReportId    String? @unique
  gbvReport      GBVReport?    @relation("VisitToGBVReport", fields: [gbvReportId], references: [id], onDelete: SetNull)
  gbvScreeningId String? @unique
  gbvScreening   GBVScreening? @relation("VisitToGBVScreening", fields: [gbvScreeningId], references: [id], onDelete: SetNull)

  patient         Patient      @relation(fields: [patientId], references: [id])
  recordedBy      User         @relation("UserRecordedANC", fields: [recordedById], references: [id])
  ultrasoundScans Ultrasound[]
}

enum RiskScore {
  Low
  Medium
  High
}

/** Flags how this visit row was created — links to ANC / PNC / GBV case for timelines. */
enum VisitCaseCategory {
  GENERAL
  ANC
  PNC
  GBV_REPORT
  GBV_SCREENING
}

model Ultrasound {
  id             String   @id @default(uuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id])
  visitId        String?
  visit          Visit?   @relation(fields: [visitId], references: [id])
  imageUrl       String
  description    String?
  gestationalAge Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // scanDate      DateTime
  annotations    String?
  takenById      String
  takenBy        User     @relation(fields: [takenById], references: [id])
}

model GBVReport {
  id                          String         @id @default(uuid())
  patientId                   String
  patient                     Patient        @relation(fields: [patientId], references: [id])
  incidentType                String?
  incidentDate                DateTime?
  allegedPerpetratorEncrypted String? // encrypted JSON/string
  victimStatementEncrypted    String?
  referralActionEncrypted     String?
  referral                    Boolean? // Referral Yes/No (Basic Information screen)
  referralInfo                String? // Insert Referral Info (optional)
  attachmentUrl               String?
  highRisk                    Boolean        @default(false)
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  recordedById                String
  recordedBy                  User           @relation(fields: [recordedById], references: [id])
  gbvScreenings               GBVScreening[]
  registrationVisit           Visit?         @relation("VisitToGBVReport")
}

model GBVScreening {
  id           String @id @default(uuid())
  patientId    String
  recordedById String

  registrationVisit Visit? @relation("VisitToGBVScreening")

  // Consent
  survivorConsentSignature   String? // Survivor signature
  caseWorkerConsentSignature String? // Case worker signature

  // Comprehensive GBV History
  gbvHistory String? // Comprehensive GBV history

  // Vital Signs
  temperature      String? // Temperature (in °c/°f)
  weightKg         Float? // Weight (kg)
  heightCm         Float? // Height (cm)
  bmiIndex         Float? // BMI Index (auto-calculating)
  bloodPressure    String? // Blood Pressure (in mmHg)
  pulse            String? // Pulse (in b/min)
  respiratoryRate  String? // Respiratory Rate
  oxygenSaturation String? // Oxygen Saturation

  // Physical Examination
  physicalExamination String? // Physical Examination notes

  // Working Diagnosis
  workingDiagnosis String? // GBV Screening and Diagnose

  // Laboratory
  laboratoryResults String? // Laboratory results

  // Test Results (Pregnancy, HIV, STI, PEP, Emergency Contraceptive)
  pregnancyTestingResults       String? // Pregnancy Testing results
  hivTestingResults             String? // HIV Testing results
  stiTestingResults             String? // STI Testing results
  postExposureProphylaxisTreatment String? // Post-Exposure Prophylaxis Treatment
  emergencyContraceptiveProvision  String? // Emergency Contraceptive Provision for FP

  // Ultrasound Request
  typeOfUltrasound              String? // Type of ultrasound
  ultrasoundMore               String? // More info (optional)
  smartUltrasoundRecommendation String? // Smart Ultrasound Recommendation

  // Treatment Plan
  treatmentPlan     String? // Treatment plan
  treatmentRx       String? // Treatment (Rx)
  continuationSheet String? // Continuation Sheet

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient     Patient    @relation(fields: [patientId], references: [id])
  recordedBy  User       @relation(fields: [recordedById], references: [id])
  gbvReport   GBVReport? @relation(fields: [gbvReportId], references: [id])
  gbvReportId String?
}

model SRHRegistration {
  id           String @id @default(uuid())
  patientId    String
  recordedById String

  // Consent
  clientConsentSignature             String? // SRH Client signature
  healthProfessionalConsentSignature String? // Health Professional signature

  // History
  srhServiceType String? // SRH Service Type (Family Planning, Routine Care, STI/HIV, Others)
  history         String? // History

  // Vital Signs
  temperature      String? // Temperature (in °C)
  weightKg         Float? // Weight (kg)
  heightCm         Float? // Height (cm)
  bmiIndex         Float? // BMI Index (auto-calculating)
  bloodPressure    String? // Blood Pressure (in mmHg)
  pulse            String? // Pulse (in b/min)
  respiratoryRate  String? // Respiratory Rate
  oxygenSaturation String? // Oxygen Saturation

  // Physical Examination
  physicalExamination String? // Physical Examination notes

  // Working Diagnosis
  workingDiagnosis String? // Working Diagnosis

  // Laboratory
  laboratoryResults String? // Laboratory results

  // Ultrasound Request
  typeOfUltrasound              String? // Type of ultrasound
  ultrasoundMore                String? // More info (optional)
  smartUltrasoundRecommendation String? // Smart Ultrasound Recommendation

  // Treatment Plan
  treatmentPlan     String? // Treatment plan
  treatmentRx       String? // Treatment (Rx)
  continuationSheet String? // Continuation Sheet

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient    Patient @relation(fields: [patientId], references: [id])
  recordedBy User    @relation(fields: [recordedById], references: [id])
}

